<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app bundle by Tauri. Without these usage strings
     macOS silently blocks camera/microphone access, so Chat's video/voice
     recorder and Meet calls never start. -->
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Google Chat uses the camera for video messages and calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Google Chat uses the microphone for voice and video messages and calls.</string>
</dict>
</plist>
